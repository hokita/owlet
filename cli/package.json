{
  "name": "owlet-cli",
  "version": "1.0.0",
  "private": true,
  "description": "Add notes to owlet from the terminal",
  "bin": {
    "owlet": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.5.0",
    "prettier": "^3.3.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.61.1",
    "vitest": "^1.6.0"
  },
  "volta": {
    "node": "24.17.0"
  }
}
